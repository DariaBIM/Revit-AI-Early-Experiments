<Window x:Class="RevitAPI_AI_Plugin.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revit Chat Window" Height="400" Width="500">
    <Grid>
        <TextBox Name="ChatBox" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" 
                 Margin="10,10,10,50" 
                 IsReadOnly="True" 
                 TextWrapping="Wrap"/>
        <TextBox Name="InputBox" 
                 Margin="10,0,120,10" 
                 VerticalAlignment="Bottom" 
                 Height="30" 
                 TextWrapping="Wrap"/>
        <Button Name="SendButton" 
                Content="Send" 
                Margin="0,0,10,10" 
                VerticalAlignment="Bottom" 
                Height="30" 
                Width="100"
                HorizontalAlignment="Right" 
                Click="SendButton_Click"/>
    </Grid>
</Window>
